rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /matches/{matchId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /news/{newsId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /tournaments/{tournamentId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /teams/{teamId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /groups/{code} {
      allow read, write: if request.auth != null
        && code is string
        && code.size() == 6;
    }
  }
}
